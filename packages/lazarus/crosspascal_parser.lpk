        <UnitName Value="SyncThread"/>
        <HasRegisterProc Value="True"/>
      </Item>
      <Item>
        <Filename Value="../../src/ThreadUtils.pas"/>
        <UnitName Value="ThreadUtils"/>
      </Item>
      <Item>
        <Filename Value="../../src/WinMem.pas"/>
        <UnitName Value="WinMem"/>
      </Item>
      <Item>
        <Filename Value="../../src/BaseTypes.pas"/>
        <UnitName Value="BaseTypes"/>
      </Item>
      <Item>
        <Filename Value="../../src/ExactTimer.pas"/>
        <UnitName Value="ExactTimer"/>
        <HasRegisterProc Value="True"/>
      </Item>
      <Item>
        <Filename Value="../../src/ScriptFormat.pas"/>
        <UnitName Value="ScriptFormat"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
