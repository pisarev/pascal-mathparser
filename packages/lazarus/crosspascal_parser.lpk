        <UnitName Value="TextConsts"/>
      </Item>
      <Item>
        <Filename Value="../../src/NumberUtils.pas"/>
        <UnitName Value="NumberUtils"/>
      </Item>
      <Item>
        <Filename Value="../../src/NumberConsts.pas"/>
        <UnitName Value="NumberConsts"/>
      </Item>
      <Item>
        <Filename Value="../../src/SearchUtils.pas"/>
        <UnitName Value="SearchUtils"/>
