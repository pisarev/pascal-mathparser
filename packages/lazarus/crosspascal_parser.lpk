<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="/"/>
    <Name Value="crosspascal_parser"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Yuriy Pisarev"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="/"/>
      <SearchPaths>
        <IncludeFiles Value="../../src"/>
        <OtherUnitFiles Value="../../src"/>
        <UnitOutputDirectory Value="parser_lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Conditionals Value="// src/compat is added OUTSIDE Windows only.
//
// There Messages comes from the LCL, and without a stand-in the package would
// have to drag the widgetset in. On Windows Messages is in the RTL, and putting
// ours in its place is not allowed: it lands in the package output directory,
// travels to the consumer through UsageOptions and shadows the system one. The
// LCL does not survive that - lmessages uses messages under {$ifdef WINDOWS},
// the checksums disagree, and the build stops at
// 'Can't find unit LMessages used by LCLIntf'.
if (TargetOS &lt;&gt; 'win32') and (TargetOS &lt;&gt; 'win64') then
  UnitPath += ';../../src/compat';"/>
      <Parsing>
        <SyntaxOptions>
          <SyntaxMode Value="Delphi"/>
        </SyntaxOptions>
      </Parsing>
      <CodeGeneration>
        <Optimizations>
          <OptimizationLevel Value="2"/>
        </Optimizations>
      </CodeGeneration>
      <Other>
        <CustomOptions Value="-dNOFORMS -dNOGRAPHICS"/>
      </Other>
    </CompilerOptions>
    <Description Value="MathParser: a compiler and interpreter of mathematical expressions (core)"/>
    <License Value="MIT"/>
    <Version Major="1" Minor="3" Release="6"/>
    <Files>
      <Item>
        <Filename Value="../../src/Parser.pas"/>
        <UnitName Value="Parser"/>
        <HasRegisterProc Value="True"/>
      </Item>
      <Item>
        <Filename Value="../../src/ParseMethod.pas"/>
        <UnitName Value="ParseMethod"/>
      </Item>
      <Item>
        <Filename Value="../../src/ParseUtils.pas"/>
        <UnitName Value="ParseUtils"/>
      </Item>
      <Item>
        <Filename Value="../../src/ParseTypes.pas"/>
        <UnitName Value="ParseTypes"/>
      </Item>
      <Item>
        <Filename Value="../../src/ParseConsts.pas"/>
        <UnitName Value="ParseConsts"/>
      </Item>
      <Item>
        <Filename Value="../../src/ParseErrors.pas"/>
        <UnitName Value="ParseErrors"/>
      </Item>
      <Item>
        <Filename Value="../../src/ParseExecution.pas"/>
        <UnitName Value="ParseExecution"/>
      </Item>
      <Item>
        <Filename Value="../../src/ParseValidator.pas"/>
        <UnitName Value="ParseValidator"/>
      </Item>
      <Item>
        <Filename Value="../../src/ParseCommon.pas"/>
        <UnitName Value="ParseCommon"/>
      </Item>
      <Item>
        <Filename Value="../../src/ParseMessages.pas"/>
        <UnitName Value="ParseMessages"/>
      </Item>
      <Item>
        <Filename Value="../../src/ParseManager.pas"/>
        <UnitName Value="ParseManager"/>
        <HasRegisterProc Value="True"/>
      </Item>
      <Item>
        <Filename Value="../../src/ParseValueList.pas"/>
        <UnitName Value="ParseValueList"/>
        <HasRegisterProc Value="True"/>
      </Item>
      <Item>
        <Filename Value="../../src/ParseCache.pas"/>
        <UnitName Value="ParseCache"/>
      </Item>
      <Item>
        <Filename Value="../../src/Cache.pas"/>
        <UnitName Value="Cache"/>
      </Item>
      <Item>
        <Filename Value="../../src/ItemCache.pas"/>
        <UnitName Value="ItemCache"/>
      </Item>
      <Item>
        <Filename Value="../../src/FlagCache.pas"/>
        <UnitName Value="FlagCache"/>
      </Item>
      <Item>
        <Filename Value="../../src/Calculator.pas"/>
        <UnitName Value="Calculator"/>
        <HasRegisterProc Value="True"/>
      </Item>
      <Item>
        <Filename Value="../../src/CalcUtils.pas"/>
        <UnitName Value="CalcUtils"/>
      </Item>
      <Item>
        <Filename Value="../../src/VariableUtils.pas"/>
        <UnitName Value="VariableUtils"/>
      </Item>
      <Item>
        <Filename Value="../../src/ValueUtils.pas"/>
        <UnitName Value="ValueUtils"/>
      </Item>
      <Item>
        <Filename Value="../../src/ValueTypes.pas"/>
        <UnitName Value="ValueTypes"/>
      </Item>
      <Item>
        <Filename Value="../../src/ValueConsts.pas"/>
        <UnitName Value="ValueConsts"/>
      </Item>
      <Item>
        <Filename Value="../../src/ValueErrors.pas"/>
        <UnitName Value="ValueErrors"/>
      </Item>
      <Item>
        <Filename Value="../../src/Notifier.pas"/>
        <UnitName Value="Notifier"/>
      </Item>
      <Item>
        <Filename Value="../../src/Connector.pas"/>
        <UnitName Value="Connector"/>
        <HasRegisterProc Value="True"/>
      </Item>
      <Item>
        <Filename Value="../../src/EventUtils.pas"/>
        <UnitName Value="EventUtils"/>
      </Item>
      <Item>
        <Filename Value="../../src/FastList.pas"/>
        <UnitName Value="FastList"/>
      </Item>
      <Item>
        <Filename Value="../../src/FlexibleList.pas"/>
        <UnitName Value="FlexibleList"/>
      </Item>
      <Item>
        <Filename Value="../../src/BlobManager.pas"/>
        <UnitName Value="BlobManager"/>
        <HasRegisterProc Value="True"/>
      </Item>
      <Item>
