<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="/"/>
    <Name Value="crosspascal_parserjit"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Yuriy Pisarev"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="/"/>
      <SearchPaths>
        <IncludeFiles Value="../../src"/>
        <OtherUnitFiles Value="../../jit"/>
        <UnitOutputDirectory Value="jit_lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <SyntaxMode Value="Delphi"/>
        </SyntaxOptions>
      </Parsing>
      <CodeGeneration>
        <Optimizations>
          <OptimizationLevel Value="2"/>
        </Optimizations>
      </CodeGeneration>
      <Other>
        <CustomOptions Value="-dNOFORMS -dNOGRAPHICS"/>
      </Other>
    </CompilerOptions>
    <Description Value="MathParser accelerator: IR, executor and x86-64 machine code generator"/>
    <License Value="MIT"/>
    <Version Major="1" Minor="3" Release="2"/>
    <Files>
      <Item>
        <Filename Value="../../jit/ParseJit.Decoder.pas"/>
        <UnitName Value="ParseJit.Decoder"/>
      </Item>
      <Item>
        <Filename Value="../../jit/ParseJit.Executor.pas"/>
        <UnitName Value="ParseJit.Executor"/>
      </Item>
      <Item>
        <Filename Value="../../jit/ParseJit.CodeGen.pas"/>
        <UnitName Value="ParseJit.CodeGen"/>
      </Item>
      <Item>
        <Filename Value="../../jit/ParseJit.Parser.pas"/>
        <UnitName Value="ParseJit.Parser"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="crosspascal_parser"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
